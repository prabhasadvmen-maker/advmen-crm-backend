{
  "name": "advmen-salesos-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Production-Grade AI-Integrated Multi-Tenant SaaS Sales CRM & Revenue Operations Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/config/seed.ts",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs --runInBand",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs tests/unit",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs tests/integration --runInBand",
    "test:tenant": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs tests/tenant-isolation --runInBand",
    "test:rbac": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs tests/rbac --runInBand"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.15",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^7.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.3",
    "multer": "^2.4.0",
    "nodemailer": "^9.0.6",
    "openai": "^7.25.0",
    "socket.io": "^4.8.3",
    "typescript": "^5.9.3",
    "uuid": "^10.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/supertest": "^6.0.2",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.4",
    "tsx": "^4.23.12"
  }
}
